    <CustomRecipeIngredients taggroup_id="babeab">
      <CustomRecipeIngredient topic="tmt7c10xt6gcw81ktyqunwz" amount="1" unit_topic="tmt_invalid_ingredient_unit" position="1" unit="Ungültige Einheit" plural="Mürbeteig (Grundrezept; aber 100 g Mehl durch 100 g braunes Reismehl ersetzen und braunen statt weißen Zucker verwenden)"/>
      <CustomRecipeIngredient topic="tmt794qf1fic0625kghe46" amount="50" unit_topic="tmt71k9kn9q8q8hixpkdbg" position="2" unit="g" plural="Zucker"/>
      <TagGroupConfig/>
