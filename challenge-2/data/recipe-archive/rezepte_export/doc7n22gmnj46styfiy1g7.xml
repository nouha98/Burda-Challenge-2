    <SubHeadline position="1">Weihnachtliches Clementinenparfait in Kranzform mit Kompott und Zimtsternen</SubHeadline>
    <Headline position="1">Clementinen-Parfait</Headline>
    <WordCount source="com.digicol.dcx">0</WordCount>
