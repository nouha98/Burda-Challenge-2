    <CustomRecipeIngredients taggroup_id="customrecipeingredients_primary">
      <CustomRecipeIngredient topic="tmt7j1v6wul2ow1hi55phyy" position="1" amount="3" suffix="(davon 1 Bio; ersatzweise Mandarinen)" plural="Clementinen"/>
