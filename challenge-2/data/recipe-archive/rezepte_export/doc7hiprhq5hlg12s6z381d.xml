    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_primary">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Blumenkohl    putzen,    ab-brausen  und  in  Röschen  tei-len.  3  Röschen  beiseitelegen.  Lauch  putzen,  abbrausen,  in  Scheiben      schneiden.      Zwiebel und Knoblauch abziehen, würfeln.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_2_613f158da90b3">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1"> Zwiebeln  und  Knob-lauch  in  einem  großen  Topf in 3 EL heißem Öl andünsten.       Blumen-kohl  und  Lauch  zuge-ben     und     andünsten.     Brühe zugießen, aufko-chen. Bei kleiner Hitze 25 Min. köcheln.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_3_613f15ae4986d">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Speckscheiben    fein    würfeln.   Übrige   Blu-menkohlröschen    klei-ner  zerteilen.  Mais  abtropfen lassen. </CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_4_613f15be36e00">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 4</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1"> Speck   in   1   EL   Öl   knusprig   braten.   Blu-menkohl zufügen und braten. Mais zufügen, erhitzen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_5_613f15caaafef">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 5</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Topf   vom   Herd   nehmen.   Suppe  cremig  pürieren.  Sah-ne einrühren und die Blumenkohl-Lauch-Suppe    mit    Salz    und    Pfeffer    abschmecken.    Suppe nochmals aufkochen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_6_613f15db64c23">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 6</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Suppe  zum  Servieren  mit  der  Speck-Mischung  und  Petersilie bestreuen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
