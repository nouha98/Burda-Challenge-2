    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_primary">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Den Ofen auf 180 Grad Ober- und Unterhitze vorheizen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_2_68a76f6242ebc">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Den Rosenkohl abbrausen, putzen und am Strunk kreuzweise einschneiden</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_3_68a76f6dd8e48">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Die Butter in einem Topf zerlassen. Das Mehl darin unter Rühren anschwitzen. Brühe und Milch unter Rühren angießen. Die Sauce mind. 10 Minuten köcheln, dann mit Salz, Pfeffer und Muskat würzig abschmecken.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_4_68a76f7fc55d6">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 4</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Den Rosenkohl mit der Sauce mischen und alles in eine Gratinform (ca. 20 x 30 cm) füllen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_5_68a76f8de8ddf">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 5</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Den Speck in Würfel schneiden und über dem Rosenkohl verteilen. Den Käse und sowie die Bröseln darüber streuen und den Auflauf in ca. 35 Minuten goldbraun backen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
