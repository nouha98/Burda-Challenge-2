      <CustomRecipeIngredient topic="tmt_ingredient_food_multisite_9721" position="4" amount="500" unit_topic="tmt71k9kn9q8q8hixpkdbg" unit="g" plural="Sahne"/>
      <CustomRecipeIngredient topic="tmt_ingredient_food_multisite_8946" position="5" amount="130" unit_topic="tmt71k9kn9q8q8hixpkdbg" unit="g" plural="Puderzucker"/>
      <CustomRecipeIngredient topic="tmt_ingredient_food_multisite_9646" position="6" amount="200" unit_topic="tmt71k9kn9q8q8hixpkdbg" unit="g" plural="Sauerrahm"/>
