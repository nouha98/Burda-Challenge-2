    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_primary">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">1Gemüse waschen, putzen bzw. schälen. Kürbis 1 1/2 cm groß würfeln. Möhren, Kartoffel, Zwiebel und Suppengrün getrennt klein schneiden. Käse getrennt fein reiben. </CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_2_5f7ae7a991852">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">2Öl in einem Topf erhitzen. Kartoffel, Möhren und Zwiebel darin rösten. Suppen-grün zugeben. 5 Min. weiterdünsten. Brühe, Kürbis und Ingwer zufügen. Aufkochen. Bei kleiner Hitze 20 Min. zugedeckt garen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_3_5f7ae7b7978a6">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">3Suppe pürieren. Etwas Mimolette darin schmelzen. Suppe mit Salz, Pfeffer und Muskat würzen. Auf Tellern anrichten. Mit Nüssen und restlichem Käse bestreuen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
