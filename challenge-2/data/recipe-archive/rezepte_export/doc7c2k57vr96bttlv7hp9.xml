      <CustomRecipeIngredient topic="tmt7byuox5j1yaai7svb6f" amount="2" unit_topic="tmt71k9kxzgczs14qz55dbs" position="6" unit="TL" plural="abgeriebene Bio-Zitronenschale"/>
