    <CustomRecipePreparationSteps taggroup_id="e16bd2">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="1"> Salate verlesen, waschen, trocken schleudern und auf einen Teller geben. Tomaten abbrausen, putzen und in Spalten schneiden. Die Paprikaschote abbrausen, halbieren, putzen und in Würfel schneiden. Die Zwiebel abziehen und in dünne Ringe schneiden.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
