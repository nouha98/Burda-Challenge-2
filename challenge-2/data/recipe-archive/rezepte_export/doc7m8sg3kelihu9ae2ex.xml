    <CustomRecipePreparationSteps taggroup_id="3a9c3d">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="1">Joghurt, Sahne, Salz, Zucker oder Wunderhutinhalt in eine Schüssel geben.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="3a9c71">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="2">Zubereitungsschritt 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="2">Zitrone heiß waschen. 1 TL Schale fein abreiben. Saft auspressen. Beides zur Joghurtmischung geben und alles gründlich verrühren.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="3a9c80">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="3">Zubereitungsschritt 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="3">Mischung in die Eismaschine füllen und cremig gefrieren lassen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="3a9c8c">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="4">Zubereitungsschritt 4</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="4">Inzwischen Kirschen mit Zucker in einem Topf aufkochen, ca. 5 Minuten köcheln lassen. Masse fein pürieren und durch ein Sieb streichen. Kalt stellen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="3a9c98">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="5">Zubereitungsschritt 5</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="5">Sobald das Joghurteis gefroren ist, einen Teil des Kirschpürees in eine stabile Schale füllen, Eis darauf verteilen und übriges Püree darübergießen. Kirschpüree mithilfe eines Löffels ins Joghurteis einmarmorieren.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="3a9ca2">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="6">Zubereitungsschritt 6</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="6">Eis nach Belieben mit Amarenakirschen garniert servieren.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
