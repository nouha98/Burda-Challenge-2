    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_primary">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1"> Zwiebeln   schälen,   grob   würfeln.   Sellerie   und   Zucchini   waschen,  in  Stücke  schneiden.  Öl  in  einem  großen  Topf  erhit­zen. Zwiebeln, Sellerie und Zucchini darin ca. 4 Min. andünsten.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_2_5fd1e46a02066">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Tomaten und Brühe zugießen, Zucker zufügen. Zugedeckt ca. 20 Min. köcheln lassen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_3_5fd1e46bcdb8d">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Suppe pürieren. Sahne zugie­ßen, kurz aufkochen und mit Salz    und    Pfeffer    ab­schmecken.     Pinien­kerne  kurz  in  einer  Pfanne ohne Öl an­rösten. Suppe auf Teller    verteilen,    mit    Pinienker­nen  und  Basili­kum  ser vieren.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
