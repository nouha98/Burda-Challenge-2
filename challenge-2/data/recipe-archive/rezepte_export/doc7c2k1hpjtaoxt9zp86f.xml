      <CustomRecipeIngredient topic="tmt786i5cf9j531aho387sm" amount="2" unit_topic="tm_topic_default_unit" position="1" unit="(Keine Einheit)" plural="Bio-Zitronen"/>
      <CustomRecipeIngredient topic="tmt7c10voy0db711hqttgak" amount="3" unit_topic="tmt71k9kxzgczs14qz55dbs" position="2" unit="TL" plural="unbehandelte Lavendelblüten"/>
      <CustomRecipeIngredient topic="tmt796pjo9plad7zxfxffs" amount="170" unit_topic="tmt71k9kn9q8q8hixpkdbg" position="3" unit="g" plural="Mandelmehl"/>
      <CustomRecipeIngredient topic="tmt7c10voygvtj1hchg1gak" amount="120" unit_topic="tmt71k9kn9q8q8hixpkdbg" position="4" unit="g" plural="Birkenzucker"/>
