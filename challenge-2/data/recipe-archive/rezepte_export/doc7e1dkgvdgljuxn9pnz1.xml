      <CustomRecipeTippsHeader position="1">Haltbarkeit Aufstrich</CustomRecipeTippsHeader>
      <CustomRecipeTippsContent position="1">Gut verschlossen im Kühlschrank bis zu fünf Tage.</CustomRecipeTippsContent>
