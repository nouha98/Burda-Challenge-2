    <CustomRecipePreparationSteps taggroup_id="a8f0f6">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="1"> Spargel waschen, schälen, die holzigen Enden abbrechen. Spargelspitzen großzügig abschneiden. Übrigen Spargel in 3 cm große Stücke schneiden. Spargelschalen und holzige Enden in einem Topf mit 1,2 l Wasser bedeckt aufkochen, ca. 5 Min. köcheln. Vom Herd nehmen, ca. 20 Min, ziehen lassen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
