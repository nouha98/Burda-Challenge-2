      <CustomRecipeIngredient topic="tmt794qg75ya8415ex5te45" amount="2" unit_topic="tm_topic_default_unit" position="1" unit="(Keine Einheit)" plural="Steinpilze"/>
      <CustomRecipeIngredient topic="tmt794qfqno4ci1hch9he46" amount="3" unit_topic="tmt71k9mrz8iyeyycjkivd" position="2" unit="Zweig" plural="Thymian"/>
      <CustomRecipeIngredient topic="tmt78664ap0z8812vpfcidm" amount="300" unit_topic="tmt71k9kn9q8q8hixpkdbg" position="3" unit="g" plural="grobes Meersalz"/>
      <CustomRecipeIngredient topic="tmt782q7xnfrkkib03x8gz" amount="1" unit_topic="tmt71k9l0iwtqu1gbohwdbs" position="4" unit="EL" plural="rosa Pfefferbeeren"/>
      <TagGroupConfig/>
