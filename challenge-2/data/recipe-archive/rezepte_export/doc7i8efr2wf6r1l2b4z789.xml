      <CustomRecipeTippsHeader position="1">Getränke-Tipp:</CustomRecipeTippsHeader>
      <CustomRecipeTippsContent position="1">Dazu passt ein frischer Müller-Thurgau aus Franken.</CustomRecipeTippsContent>
    </CustomRecipeTipps>
