    <CustomRecipePreparationSteps taggroup_id="bbb870">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="1">1 Zwiebeln und Knoblauch abziehen, würfeln. Fleisch portionsweise in einem ofenfesten Schmortopf im heißen Öl kräftig anbraten, dann herausnehmen. Zwiebeln und Knoblauch im Bratfett kurz hell anbraten. Hack, Mark, Tomaten und Brühe in den Topf geben. Bei kleiner Hitze unter gelegentlichem Rühren ca. 30 Min. schmoren.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="bbb8a2">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="2">Zubereitungsschritt 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="2">2 Bohnen abbrausen, gut abtropfen lassen. Bohnen ca. 10 Min. vor Ende der Garzeit unter das Chili rühren. Alles kräftig mit Salz, Pfeffer, Zucker und Chilipulver würzen. Petersilie fein schneiden.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="bbb8b0">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="3">Zubereitungsschritt 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="3">3 Den Ofen auf 220 Grad (Umluft 200 Grad) vorheizen. Chili con Carne mit den Chips belegen. Den Käse aufstreuen. Im Ofen in ca. 7 Min. gratinieren. Mit Petersilie garniert sofort servieren.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
