    <CustomRecipePreparationSteps taggroup_id="b742dd">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="1">Bio-Orange heiß waschen, trocken reiben. Schale fein abreiben, sodass man etwa 1–2 TL erhält. Alle Früchte auspressen. Es sollten 424 g Saft zusammenkommen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="b7432b">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="2">Zubereitungsschritt 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="2">Alle pulverförmigen Zutaten (die verschiedenen Zucker, Säure, Bindemittel, Salz) zusammenmischen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="b74339">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="3">Zubereitungsschritt 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="3">Saft, Schale und 15 g ausgepresstes Fruchtfleisch, das in der Presse übrig geblieben ist, in ein hohes Rührgefäß füllen. Zuckermischung hinzugeben und alles mit dem Stabmixer fein aufpürieren.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="b74347">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="4">Zubereitungsschritt 4</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="4">Orangen-Mix in eine Eismaschine füllen und cremig gefrieren lassen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="b74352">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="5">Zubereitungsschritt 5</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="5">Eis nach Belieben in Waffeln oder Schalen servieren.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipeTipps taggroup_id="b74488">
      <TagGroupConfig/>
      <CustomRecipeTippsLabel/>
      <CustomRecipeTippsHeader position="1">Farbige Eiswaffeltüten </CustomRecipeTippsHeader>
      <CustomRecipeTippsContent position="1">Supercool und witzig serviert man selbst gemachtes Eis in bunten Eiswaffeltüten (z.B. von Mühlheimer Manufaktur, mehrere Farben, bestellbar unter www.mynaschbar.de).</CustomRecipeTippsContent>
    </CustomRecipeTipps>
    <CustomRecipeTipps taggroup_id="customrecipetipps_2_62f372b13d1ae">
      <TagGroupConfig/>
      <CustomRecipeTippsLabel position="1">Tipps 2</CustomRecipeTippsLabel>
      <CustomRecipeTippsHeader position="1">Info: Dextrose (Traubenzucker)</CustomRecipeTippsHeader>
      <CustomRecipeTippsContent position="1">Bindet Wasser im Eis (verhindert Kristalle), ohne zu sehr zu süßen (z. B. von Ruf).</CustomRecipeTippsContent>
    </CustomRecipeTipps>
    <CustomRecipeTipps taggroup_id="customrecipetipps_3_62f372cbec026">
      <TagGroupConfig/>
      <CustomRecipeTippsLabel position="1">Tipps 3</CustomRecipeTippsLabel>
      <CustomRecipeTippsHeader position="1">Info: Glucose</CustomRecipeTippsHeader>
      <CustomRecipeTippsContent position="1">Gibt’s als Sirup oder Pulver. Verhindert ebenfalls unerwünschte Kristallbildung. </CustomRecipeTippsContent>
    </CustomRecipeTipps>
    <CustomRecipeTipps taggroup_id="customrecipetipps_4_62f372de10a29">
      <TagGroupConfig/>
      <CustomRecipeTippsLabel position="1">Tipps 4</CustomRecipeTippsLabel>
      <CustomRecipeTippsHeader position="1">Info: Maltodextrin</CustomRecipeTippsHeader>
      <CustomRecipeTippsContent position="1">Zuckerart mit geringer Süßkraft. Aus Stärke gewonnen (in Apotheken). </CustomRecipeTippsContent>
    </CustomRecipeTipps>
    <CustomRecipeTipps taggroup_id="customrecipetipps_5_62f372f018ca9">
      <TagGroupConfig/>
      <CustomRecipeTippsLabel position="1">Tipps 5</CustomRecipeTippsLabel>
      <CustomRecipeTippsHeader position="1">Info: Johannisbrotkernmehl</CustomRecipeTippsHeader>
      <CustomRecipeTippsContent position="1">Natürliches Verdickungsmittel aus den Früchten des Johannisbrotkernbaums (z. B. von Rapunzel).</CustomRecipeTippsContent>
    </CustomRecipeTipps>
    <CustomRecipeTipps taggroup_id="customrecipetipps_6_62f3731552b67">
      <TagGroupConfig/>
      <CustomRecipeTippsLabel position="1">Tipps 6</CustomRecipeTippsLabel>
      <CustomRecipeTippsHeader position="1">Info: Guarkernmehl</CustomRecipeTippsHeader>
      <CustomRecipeTippsContent position="1">Ein Geliermittel und Stabilisator aus dukt „Wunderhut“ auf der Guarbohne (z. B. von Biovegan).</CustomRecipeTippsContent>
    </CustomRecipeTipps>
