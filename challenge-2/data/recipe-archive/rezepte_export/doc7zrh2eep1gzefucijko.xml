    <CustomRecipePreparationSteps taggroup_id="b6363c">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader position="1">Kartoffel-Weißwurst-Salat</CustomRecipePreparationsStepsHeader>
      <CustomRecipePreparationsStepsContent position="1"> Die Kartoffeln waschen und in Salzwasser ca. 25 Min. kochen. 1 Zwiebel abziehen und fein würfeln. In Brühe aufkochen. Kartoffeln abgießen, pellen und in Würfel schneiden. Zwiebelbrühe, Senf und Essig untermischen. Ca. 30 Min. ziehen lassen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="b636a1">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="2">Zubereitungsschritt 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="2"> Das Gemüse abbrausen und putzen. Radieschen in dünne Scheiben, Gurke in kleine Würfel schneiden. Salat waschen, putzen und klein zupfen. 1 Zwiebel abziehen. Lorbeer mit der Nelke darauf feststecken. In einem Topf mit 2 l Wasser aufkochen. Vom Herd ziehen. Würste hineingeben. 5–10 Min. ziehen lassen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="b636b2">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="3">Zubereitungsschritt 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="3"> Radieschen mit Gurken und Salat unter die Kartoffeln mischen. Mit Salz und Pfeffer abschmecken. Öl untermischen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="b636bf">
