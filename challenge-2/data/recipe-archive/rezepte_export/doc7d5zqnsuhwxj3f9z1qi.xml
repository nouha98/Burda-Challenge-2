    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_primary">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Gemüse  waschen.  Zucchini  in  feine Scheiben schneiden. Möhren schälen,   ebenfalls   in   Scheiben   schneiden. Brokkoli in Röschen tei-len.  Bohnen  in  Stücke  schneiden.  Brokkoli,  Bohnen  und  Möhren  in  wenig  Wasser  ca.  10  Min.  dämp-fen, bis sie bissfest sind. Schalotte abziehen, fein würfeln.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_2_5facf68ae59bd">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">1  EL  Öl  in  einer  großen  Pfanne  erhitzen,   Schalotte   und   Gemüse   darin andünsten.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_3_5facf68ba84aa">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">1 EL Öl in einer zweiten Pfanne erhitzen, Lachs darin auf der Ober-seite  scharf  anbraten,  dann  wen-den und auf der Hautseite bei mitt-lerer  Hitze  langsam  durchbraten  lassen. Alles würzen. Mit Zitronen-scheiben servieren.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
