    <CustomRecipePreparationSteps taggroup_id="1b1592">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="1">1 Eier trennen. Mehl, Butter, 50 g Zucker und die Eigelbe glatt verkneten. Den Teig in Folie wickeln und 1 Std. kühl stellen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="1b15ca">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="2">Zubereitungsschritt 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="2">2 Rhabarber waschen, putzen, klein schneiden, mit 80 g Zucker mischen. 90 ml Saft zufügen, aufkochen. 30 ml Saft und Puddingpulver verrühren, zum Rhabarber geben, kurz aufkochen lassen. Den Backofen auf 180 Grad (Umluft 160 Grad) vorheizen. 6 Tarteletteförmchen (Ø 10 cm) gut fetten. Mürbeteig ausrollen und in die Förmchen legen, Rand andrücken. Rhabarbermasse auf den Tartelettes verteilen. 25–30 Min. backen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="1b15de">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="3">Zubereitungsschritt 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="3">3 Backofen auf 220 Grad (Umluft 200 Grad) einstellen. Für den Baiser die Eiweiße mit 1 Prise Salz steif schlagen. 80 g Zucker nach und nach einrieseln lassen. Die Masse in einen Spritzbeutel mit Sterntülle füllen, auf die Tartelettes spritzen. Im Ofen ca. 5 Min. backen, bis die Baisertupfen zart gebräunt sind.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
