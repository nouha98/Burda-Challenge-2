      <CustomRecipeIngredient topic="tmt7c10y8vvk9k1jwhgv2q8" amount="150" unit_topic="tmt71k9kj4jryb1c5ozqdbg" position="2" unit="ml" plural="Korn (oder anderer klarer Schnaps wie z. B. Wodka)"/>
      <CustomRecipeIngredient topic="tmt794qf8zsuz5j1w4ye46" amount="50" unit_topic="tmt71k9kn9q8q8hixpkdbg" position="3" unit="g" plural="Puderzucker"/>
      <CustomRecipeIngredient topic="tmt796nfzq73zq23b2jffs" amount="2" unit_topic="tmt71k9kxzgczs14qz55dbs" position="4" unit="TL" plural="Spekulatiusgewürz"/>
      <CustomRecipeIngredient topic="tmt796nnqe88601jyohhffs" amount="250" unit_topic="tmt71k9kn9q8q8hixpkdbg" position="5" unit="g" plural="Sahne"/>
      <TagGroupConfig/>
      <CustomRecipeIngredientsHeader position="0">Zutaten</CustomRecipeIngredientsHeader>
    </CustomRecipeIngredients>
    <CustomRecipePreparationSteps taggroup_id="4bc2ea">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Die Nuss-Nugat-Creme in einem kleinen Topf oder in der Mikrowelle leicht erhitzen, sodass eine leicht flüssige Masse entsteht.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="4bc2f9">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="2">Zubereitungsschritt 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="2">Den Schnaps, die Nuss-Nugat-Creme, Puderzucker und Spekulatiusgewürz verrühren, bis eine glatte Masse entstanden ist.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="4bc307">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="3">Zubereitungsschritt 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="3">Sahne in einer Schüssel etwas cremig rühren und anschließend unter die Nuss-Nugat- Masse rühren, bis beide gut miteinander verbunden sind.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="4bc315">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="4">Zubereitungsschritt 4</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="4">Den Spekulatiuslikör in 2 sterile Bügelflaschen (à ca. 200 ml) oder andere dekorative Flaschen abfüllen. Vor dem Servieren die Flaschen nochmals schütteln.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipeTipps taggroup_id="4bc2d3">
      <TagGroupConfig/>
      <CustomRecipeTippsLabel position="1">Tipp 1</CustomRecipeTippsLabel>
      <CustomRecipeTippsHeader position="1">Allgemeiner Tipp</CustomRecipeTippsHeader>
      <CustomRecipeTippsContent position="1">Den Likör mithilfe eines Trichters in die Flaschen füllen. Je nach Geschmacksvorliebe kann der Likör statt mit Spekulatiusgewürz auch nur mit Zimt oder Lebkuchengewürz verfeinert werden. Der Likör ist im Kühlschrank 2–3 Wochen haltbar. Zum Verschenken Flaschen mit einem Keks als Anhänger garnieren.</CustomRecipeTippsContent>
    </CustomRecipeTipps>
