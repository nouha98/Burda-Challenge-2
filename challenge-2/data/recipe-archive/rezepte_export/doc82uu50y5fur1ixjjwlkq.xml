    <CustomRecipePreparationSteps taggroup_id="82uu50y5aj4uu7fllkq">
      <TagGroupConfig/>
      <CustomRecipePreparationsStepsContent position="1">Die Fleischwurst und die Schinkenwurst in Scheiben schneiden und daraus sehr dünne Streifen schneiden. Die Essiggurken ebenso in dünne Streifen schneiden.</CustomRecipePreparationsStepsContent>
      <CustomRecipePreparationStepsLabel position="1">Schritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader position="1">Für den Fleischsalat</CustomRecipePreparationsStepsHeader>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="82uu50y5cww908ulkq">
      <TagGroupConfig/>
      <CustomRecipePreparationsStepsContent position="3">In einer Schüssel Miracel Whip, Mayonnaise und Joghurt mit dem Salz und dem Pfeffer verrühren, 50 ml Essiggurkenwasser dazu rühren und die Wurst- und Gurkenstreifen untermengen.</CustomRecipePreparationsStepsContent>
      <CustomRecipePreparationStepsLabel position="3">Schritt 3</CustomRecipePreparationStepsLabel>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="82uu50y5d0p72gr5lkq">
      <TagGroupConfig/>
      <CustomRecipePreparationsStepsContent position="4">Die Kräuter waschen und abtropfen lassen. Blätter vom Stiel zupfen, fein hacken und vor dem Servieren über den Salat streuen. Guten Appetit!</CustomRecipePreparationsStepsContent>
      <CustomRecipePreparationStepsLabel position="4">Schritt 4</CustomRecipePreparationStepsLabel>
    </CustomRecipePreparationSteps>
