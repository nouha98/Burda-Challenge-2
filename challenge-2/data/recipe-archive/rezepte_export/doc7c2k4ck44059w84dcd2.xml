      <CustomRecipeIngredient topic="tmt7c10yahx7rmf05zinwz" amount="2" unit_topic="tm_topic_default_unit" position="12" unit="(Keine Einheit)" plural="Lebkuchenhäuser (selbst gebacken oder vom Konditor) zum Garnieren"/>
