    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_primary">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Wakame überbrühen, 10 Min. ziehen lassen. Je 3 EL Essig und Öl mit Limettensaft, Ingwer, Zucker verrühren. Knoblauch abziehen, dazupressen. Wakame ausgedrückt 1 Std. im Dressing marinieren.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_2_61c3015e702f7">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Kohl hobeln. Je 1 EL Essig und Öl mit Sojasoße und Sirup verrühren. Kohl 30 Min. darin marinieren.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_3_61c3016845ada">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Reis nach Packungsangabe in Salzwasser garen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_8_61c301ce98ce7">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 4</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Lachs 5–7 Min. dämpfen. Mit abgetropften Salaten, Nüssen und Mayonnaise in Schalen auf Reis anrichten.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
