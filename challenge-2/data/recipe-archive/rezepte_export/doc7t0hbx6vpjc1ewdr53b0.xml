    <CustomRecipePreparationSteps taggroup_id="c17929">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="1">1 Die Zwiebel und den Knoblauch abziehen. Die Tomaten und die Paprika abbrausen und putzen. Alles klein würfeln. Das Hackfleisch in einer Pfanne im heißen Öl krümelig braten. Zwiebeln, Knoblauch und Paprika hinzufügen und goldbraun braten. Das Tomatenmark untermischen. Alles mit dem Wein ablöschen. Dann die Tomaten und Kräuter zugeben. Den Hackfleisch-Mix unter gelegentlichem Rühren ca. 20 Min. sanft köcheln lassen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="c17959">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="2">Zubereitungsschritt 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="2">2 Inzwischen in einem großen Topf Salzwasser aufkochen lassen. Nudeln darin bissfest kochen. Den Ofen auf 200 Grad (Umluft 180 Grad) vorheizen. Eine hohe Auflaufform (20x25 cm) fetten.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="c17968">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="3">Zubereitungsschritt 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="3">3 Die Nudeln abgießen, abschrecken und abtropfen lassen. Die Hackfleischsoße mit Salz, Pfeffer und Zucker würzig abschmecken. Die Nudeln mit der Hälfte des Käses untermischen. Den Nudel-Hack-Mix in die Auflaufform füllen und mit dem übrigen Käse bestreuen. Im Backofen in ca. 20 Min. goldbraun überbacken. Nach Belieben mit einigen Oreganoblättchen garnieren.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipeTipps taggroup_id="c17bf7">
      <TagGroupConfig/>
      <CustomRecipeTippsLabel/>
      <CustomRecipeTippsHeader/>
      <CustomRecipeTippsContent position="1">TIPPS: Wenn Sie keine wirklich aromatischen Tomaten bekommen, sind gehackte Tomaten aus der Dose ein guter Ersatz.</CustomRecipeTippsContent>
    </CustomRecipeTipps>
