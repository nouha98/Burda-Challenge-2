    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_primary">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">1.  Mais  abtropfen  lassen,  mit  Ge-müsebrühe  in  einem  Topf  aufko-chen  und  zugedeckt  ca.  10  Min.  köcheln    lassen.    Zwiebel    und    Knoblauch abziehen, fein würfeln. Mais vom Herd nehmen und pürie-ren.   Durch   ein   Sieb   streichen,   Flüssigkeit auffangen. </CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_2_5f7edc89808fb">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">2. Butter    zerlassen,    Zwiebel,    Knoblauch   und   Mehl   darin   an-schwitzen.  Mit  Mais-Brühe  ablö-schen.  Aufkochen,  Sahne  einrüh-ren  und  unter  Rühren  ca.  2  Min.  köcheln lassen. Abschmecken. </CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_3_5f7edc8bedb85">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">3. Maiskolben  erwärmen,  Stücke  abschneiden. Suppe mit Mais und Petersilie  servieren.  Dazu  passen  warme Weizen-Tortillas.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
