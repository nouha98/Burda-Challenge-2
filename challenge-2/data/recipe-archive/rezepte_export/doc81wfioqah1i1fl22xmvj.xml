    <CustomRecipePreparationSteps taggroup_id="81wfioqa92oyzkzemvj">
      <TagGroupConfig/>
      <CustomRecipePreparationsStepsContent position="3">Den Topf vom Herd nehmen und alles kurz abkühlen lassen. Dann mit einem Pürierstab gründlich durchpürieren. Die Soße kann warm oder kalt serviert werden. Im Kühlschrank hält sie sich mindestens 3 Tage.</CustomRecipePreparationsStepsContent>
      <CustomRecipePreparationStepsLabel position="3">Schritt 3</CustomRecipePreparationStepsLabel>
    </CustomRecipePreparationSteps>
