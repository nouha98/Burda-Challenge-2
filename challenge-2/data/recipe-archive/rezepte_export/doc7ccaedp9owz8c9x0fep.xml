      <CustomRecipeTippsLabel position="1">Tipps 1</CustomRecipeTippsLabel>
      <CustomRecipeTippsContent position="1">TIPP:  Vor  dem  Backen  grobes Salz aufstreuen.</CustomRecipeTippsContent>
