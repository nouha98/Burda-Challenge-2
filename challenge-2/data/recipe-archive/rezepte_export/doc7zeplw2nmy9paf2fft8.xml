    <CustomRecipePreparationSteps taggroup_id="4e1395">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="1"> Gemüse abbrausen, putzen. Paprika halbieren. Zucchini längs in dünne Scheiben hobeln. Mit 2 EL Öl, Salz und Pfeffer mischen. 3–4 Min. grillen. Paprika 10–15 Min. auf der Hautseite grillen, bis sie schwarz ist. Feucht abdecken und abkühlen. Häuten.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="4e1415">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="2">Zubereitungsschritt 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="2"> Fenchel anrösten. Abkühlen. Zerstoßen. Knoblauch abziehen. 1 Zehe würfeln. Kräuter abbrausen, abtupfen, hacken. Gemüse, Petersilie, Minze, 4 EL Zitronensaft, Honig, Salz, Pfeffer, gehackten Knoblauch, Fenchel, Chili und 4 EL Öl mischen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="4e1424">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="3">Zubereitungsschritt 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="3"> Fisch abbrausen, abtupfen. 1 Knoblauchzehe in Scheiben schneiden. Mit Beeren, Dill, Salz und 2 EL Zitronensaft mischen. Fisch damit würzen. 13–18 Min. mit Zitronen auf Grillschalen bei geschlossenem Deckel grillen. Mit Gemüse und Schmand anrichten.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
