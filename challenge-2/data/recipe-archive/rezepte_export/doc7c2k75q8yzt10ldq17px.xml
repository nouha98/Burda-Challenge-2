    <CustomRecipePreparationSteps taggroup_id="5de432">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Alles Gemüse vorbereiten und würfeln. 5–10 Min. in einem Topf in Öl sanft dünsten. Hack zufügen, krümelig anbraten. Wein, Tomaten, Brühe, Mark und Oregano in den Topf geben. 2 Std. sanft köcheln lassen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="5de442">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="2">Zubereitungsschritt 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="2">Milch zufügen. 10 Min. köcheln. Mit Salz und Pfeffer würzen. Zu Pasta reichen.</CustomRecipePreparationsStepsContent>
