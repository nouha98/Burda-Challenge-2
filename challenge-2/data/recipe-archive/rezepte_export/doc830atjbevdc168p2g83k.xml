    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_primary">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Alle Zutaten für den leckeren Nudelteig sollte man zu Beginn griffbereit bereitstellen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_2_68ffeecfe0e32">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">In das Mehl eine Mulde formen. Restliche Zutaten hineingeben. Vom Rand her mischen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_3_68ffeedf989dd">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Mit den Händen gut zu einem glatten Teig verkneten. Als Kugel in Frischhaltefolie wickeln.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_4_68ffeeec3429c">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 4</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Nach einer Ruhezeit von gut 1 Std. den Teig mit der Nudelmaschine dünn auswalzen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_5_68ffeefc0d9ad">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 5</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Teig evtl. mit Mehl bestäuben, dann mit der Maschine vorsichtig in Bandnudeln schneiden</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_6_68ffef09ce949">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 6</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Zum Trocknen gut bemehlt ca. 2 Tage über einen Drahtbügel oder eine Holzstange hängen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
