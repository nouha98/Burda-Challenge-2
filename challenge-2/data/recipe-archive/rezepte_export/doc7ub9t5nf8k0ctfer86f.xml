    <CustomRecipePreparationSteps taggroup_id="64017e">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="1"> Ofen auf 180 Grad Ober-/Unterhitze vorheizen. 45 g Kokosraspel anrösten. 20 g davon mit Mehl, 40 g Zucker, Butter, 1 TL Wasser verkneten. In mit Backpapier ausgelegte Springform (Ø 20 cm) drücken. Mehrmals einstechen und 12–15 Min. backen. Herausnehmen, auskühlen lassen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="6401b5">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="2">Zubereitungsschritt 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="2"> Ungeröstete Raspel in Milch aufkochen. Vom Herd nehmen. Likör einrühren. 4 Blatt Gelatine einweichen, ausdrücken, in Milch auflösen, kühlen. 250 g Sahne, Vanillezucker steif schlagen. Beginnt die Milch zu gelieren, geschlagene Sahne unterheben.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="6401c3">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="3">Zubereitungsschritt 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="3"> Biskuit waagerecht halbieren. Kokosboden mit Konfitüre bestreichen. Untern Biskuitboden darauflegen. Mit einem Tortenring umschließen. Kokoscreme einfüllen, den zweiten Biskuit auflegen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="6401ce">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="4">Zubereitungsschritt 4</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="4"> Beeren, 50 g Zucker pürieren. 8 Blatt Gelatine einweichen, bei kleiner Hitze auflösen. Püree unterrühren. 250 g Sahne steif schlagen, unterheben, auf die Torte streichen. Ca. 2 Std. kühlen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="6401d8">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="5">Zubereitungsschritt 5</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="5"> 100 g Sahne steif schlagen, an den Tortenrand streichen. 25 g geröstete Kokosraspel andrücken. Evtl. mit Erdbeeren und Marzipan-Osterdeko verzieren.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="6401e3">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="6">Zubereitungsschritt 6</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="6"/>
    </CustomRecipePreparationSteps>
    <CustomRecipeTipps taggroup_id="customrecipetipps_primary">
      <TagGroupConfig/>
      <CustomRecipeTippsLabel position="1">Tipps 1</CustomRecipeTippsLabel>
      <CustomRecipeTippsHeader position="1">Extra-Tipp: Süße Möhrendekoration</CustomRecipeTippsHeader>
      <CustomRecipeTippsContent position="1">Zum Verzieren der Kastentorte  2 lange, dünne 
Möhren schälen, mit einem Sparschäler längs in dünne Scheiben 
hobeln. 500 ml Wasser aufkochen. 
1 EL Honig und Möhren zugeben, 
zugedeckt aufkochen. Vom Herd ziehen, 8–10 Min. ziehen lassen. Möhren abtropfen, abtupfen, aufrollen.</CustomRecipeTippsContent>
    </CustomRecipeTipps>
