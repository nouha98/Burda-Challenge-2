      <CustomRecipeTippsLabel position="1">Tipps 1</CustomRecipeTippsLabel>
      <CustomRecipeTippsContent position="1">Haltbarkeit: kühl und dunkel ca. 1 Woche</CustomRecipeTippsContent>
