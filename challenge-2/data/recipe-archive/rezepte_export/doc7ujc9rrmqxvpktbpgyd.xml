    <CustomRecipePreparationSteps taggroup_id="9aec57">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="1">1 Hefe in eine Schüssel bröckeln. Mit Zucker und 350 ml lauwarmem Wasser verrühren. Mehl, 2 EL Öl und 2 TL Salz zugeben. Alles zu einem glatten Teig verkneten. Den Hefeteig an einem warmen Ort zugedeckt ca. 1 Std. gehen lassen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="9aec8d">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="2">Zubereitungsschritt 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="2">2 Den Knoblauch abziehen und in feine Scheiben teilen. Den Spargel waschen, im hinteren Drittel schälen und die holzigen Enden abbrechen. Die Spargelstangen halbieren und längs in dünne Scheiben schneiden. 2 EL Öl und etwas Salz zufügen. Vermengen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="9aec9a">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="3">Zubereitungsschritt 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="3">3 Den Backofen auf 220 Grad (Umluft 200 Grad) vorheizen. 2 Bleche fetten. Den Teig halbieren. Beide Portionen ca. 2 cm dick ausrollen. Je auf ein Blech legen. Mozzarella in Scheiben darauflegen. Spargel und Knoblauch darauf verteilen. Die Focaccias nacheinander je ca. 20 Min. backen. Mit Pfeffer würzen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
