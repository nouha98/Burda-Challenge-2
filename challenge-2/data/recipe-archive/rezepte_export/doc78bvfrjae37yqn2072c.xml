    <CustomRecipePreparationSteps taggroup_id="771565">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Spekulatius so fein wie möglich in Alleszerkleinerer, Kaffeemühle oder Küchenmaschine zermahlen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="771571">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="2">Zubereitungsschritt 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="2">Butter schmelzen, Gewürze, Kakao und Zucker dazugeben. Alles gut verrühren, bis sich der Zucker gelöst hat.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="771584">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="3">Zubereitungsschritt 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="3">In einer Schüssel Spekulatiusbrösel mit dem Butter-Mix und Kondensmilch mit den Schneebesen des Handrührers glatt rühren.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="771593">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="4">Zubereitungsschritt 4</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="4">Aufstrich in saubere Gläser verteilen. Gläser verschließen und kühl stellen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipeTipps taggroup_id="771535">
      <TagGroupConfig/>
      <CustomRecipeTippsLabel position="1">Tipp 1</CustomRecipeTippsLabel>
      <CustomRecipeTippsHeader position="1">Haltbarkeit</CustomRecipeTippsHeader>
      <CustomRecipeTippsContent position="1">2–3 Wochen (gekühlt).</CustomRecipeTippsContent>
    </CustomRecipeTipps>
    <CustomRecipeTipps taggroup_id="77154b">
      <TagGroupConfig/>
      <CustomRecipeTippsLabel position="2">Tipp 2</CustomRecipeTippsLabel>
      <CustomRecipeTippsHeader position="2">Streichzart servieren</CustomRecipeTippsHeader>
      <CustomRecipeTippsContent position="2">Damit er sich gut auf Brot, Toast, Hefezopf usw. verteilen lässt, den Aufstrich am besten 20 Minuten vor dem Servieren aus dem Kühlschrank nehmen.</CustomRecipeTippsContent>
