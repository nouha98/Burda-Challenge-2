      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="1">Schalotte und Knoblauch abziehen, hacken. Artischocken abtropfen lassen. Petersilienblättchen abzupfen, ein paar Blättchen beiseitelegen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="5b6697">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="2">Zubereitungsschritt 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="2">Artischocken, Frischkäse, Schalotte, Knoblauch und restliche Petersilie in einem Mixer zu einer feinen Masse pürieren.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
