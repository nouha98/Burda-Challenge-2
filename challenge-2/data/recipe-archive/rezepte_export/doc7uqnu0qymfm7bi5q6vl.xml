    <CustomRecipePreparationSteps taggroup_id="34de68">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="1"> Kohlrabi schälen (Blätter aufbewahren), fein würfeln. Lauch abbrausen, putzen, das Weiße und Hellgrüne in Ringe schneiden. Die Zwiebel abziehen, würfeln. In Butter glasig dünsten. Lauch, Kohlrabiwürfel zugeben, kurz mitdünsten. Wein und Wermut angießen, einkochen. Brühe, Lorbeer zugeben, 15 Min. kochen, bis das Gemüse weich ist.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="34deb4">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="2">Zubereitungsschritt 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="2"> Kräuter und Kohlrabiblätter abbrausen. Kräuterblättchen abzupfen. Lorbeer, 6 EL Gemüse aus der Suppe nehmen. Kräuter, bis auf etwas Kerbel, mit 60 g Sahne zur Suppe geben. Fein pürieren. Mit Salz, Pfeffer und Muskat abschmecken. Forelle zerpflücken.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="34dec3">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="3">Zubereitungsschritt 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="3"> Suppe anrichten. Mit übrigem Gemüse, Forelle, übriger Sahne, übrigem Kerbel, Pfeffer und den Kohlrabiblättchen garnieren.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
