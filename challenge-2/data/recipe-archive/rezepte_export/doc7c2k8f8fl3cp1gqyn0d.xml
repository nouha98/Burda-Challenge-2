    <CustomRecipePreparationSteps taggroup_id="9df212">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Die Kartoffeln schälen und ca. 10 Min. in gesalzenem Wasser garen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="9df221">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="2">Zubereitungsschritt 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="2">Den Spargel schälen. Die holzigen Enden abbrechen. Die Drillinge abgießen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="9df22f">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="3">Zubereitungsschritt 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="3">20 g Butter in einer Pfanne zerlassen. Den Spargel mit Zitronensaft, Zucker und 3 EL Wasser in die Pfanne geben. Mit Salzwürzen. Spargel ca. 15 Min. zugedeckt bei schwacher Hitze bissfest garen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="9df23b">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="4">Zubereitungsschritt 4</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="4">Medaillons mit Salz und Pfeffer würzen. In einer Pfanne in 20 g Butter bei mittlerer Hitze ca. 8 Min. unter Wenden braten.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="9df246">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="5">Zubereitungsschritt 5</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="5">Crème fraîche auf den Spargel in der Pfanne geben und ca. 4 Min. erhitzen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="9df250">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="6">Zubereitungsschritt 6</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="6">Währendessen die Kartoffeln im erhitzten Öl rundherum goldbraun anbraten.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="9df25c">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="7">Zubereitungsschritt 7</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="7">Basilikumblätter von den Zweigen zupfen und in feine Streifen schneiden. Medaillons samt Bratsud und den Spargel mit Crème-fraîche-Soße auf Tellern anrichten. Basilikum auf das Gemüse streuen. Die Kartoffeln in einer Schüssel dazu servieren.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
