    <CustomRecipePreparationSteps taggroup_id="493d23">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Spinat auftauen lassen. Nudeln in Salzwasser bissfest kochen, abtropfen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="493d35">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="2">Zubereitungsschritt 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="2">Knoblauch mit Dosentomaten samt Saft, Salz, Zucker aufkochen. Ca. 5 Min. kochen, dann mit Stabmixer pürieren.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="493d46">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="3">Zubereitungsschritt 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="3">Spinat ausdrücken, grob hacken. Mit Zwiebel und Ricotta verrühren, mit Salz, Pfeffer und Zitronenschale würzen. Den Mix in die abgetropften Muschelnudeln füllen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="493d54">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="4">Zubereitungsschritt 4</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="4">Tomatensoße in eine ofenfeste Form geben. Gefüllte Muschelnudeln hineinsetzen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="493d62">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="5">Zubereitungsschritt 5</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="5">Den Backofen auf 200 Grad (Umluft 180 Grad) vorheizen. Den Gouda über die Muschelnudeln streuen. Nudeln im Ofen 20–25 Min. überbacken.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
