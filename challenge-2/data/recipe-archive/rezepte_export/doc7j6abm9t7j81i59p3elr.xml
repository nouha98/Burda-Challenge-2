    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_primary">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Kirschen abbrausen, entkernen, mit Gelierzucker, Zitronensaft 5 Min. kochen. Grob zerdrücken. Kühlen. Ofen auf 180 Grad (Umluft 160 Grad) vorheizen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_2_61d7eddb46d52">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">30 g Raspel, 25 g Butter schmelzen. Eier trennen. Eigelbe, 20 g Zucker schaumig schlagen. Buttermasse unterrühren. Eiweiße, 60 g Zucker steif schlagen. Auf den Eischaum geben. Mehl, Kakao und  Mandelmehl unterheben. Auf ein Blech mit Backpapier streichen, 12–15 Min. backen. Auf ein gezuckertes Tuch stürzen, Auskühlen. Papier abziehen. </CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_3_61d7ede2ecfc5">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Milch, Vanille, 50 g Zucker aufkochen. Reis darin 20 Min. unter Rühren garen. Gelatine ausdrücken, darin auflösen. Abkühlen. 100 g Sahne steif schlagen, unterheben. Auf den Biskuit streichen. Kirschen daraufgeben. Aufrollen. 1 Std. kalt stellen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_4_61d7edea9d880">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 4</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">25 g Butter, 170 g Schokolade in 100 g heißer Sahne auflösen. 50 ml Wasser, 70 g Zucker aufkochen. Schokolade unterrühren. Etwas abkühlen. Rolle damit überziehen. Ca. 60 Min. kühlen. Evtl. mit Kirschen und Schokolocken garnieren.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
