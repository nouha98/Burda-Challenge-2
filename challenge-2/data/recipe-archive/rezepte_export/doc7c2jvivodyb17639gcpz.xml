      <TagGroupConfig/>
      <CustomRecipeIngredientsHeader position="0">Zutaten</CustomRecipeIngredientsHeader>
    </CustomRecipeIngredients>
    <CustomRecipePreparationSteps taggroup_id="04ee92">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Kirschen waschen und entsteinen. Früchte mit 1 EL Wasser und 2 EL Zucker kurz aufkochen. Kirschsoße abkühlen lassen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="04eea3">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="2">Zubereitungsschritt 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="2">Für den Zuckersirup 300 ml Wasser mit restlichem Zucker kochen, bis sich der Zucker aufgelöst hat. Abkühlen lassen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="04eeb3">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="3">Zubereitungsschritt 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="3">Pfirsiche gut abtropfen lassen. Früchte mit Zitronensaft zu einem feinem Mus pürieren. Zuckersirup untermischen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="04eec2">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="4">Zubereitungsschritt 4</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="4">Pfirsichmasse abwechselnd mit Kirschsoße in eine mit Frischhaltefolie ausgekleidete Kastenform füllen. Mit Frischhaltefolie bedeckt 5–6 Std. tiefkühlen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipeTipps taggroup_id="04ee79">
      <TagGroupConfig/>
      <CustomRecipeTippsLabel position="1">Tipp 1</CustomRecipeTippsLabel>
      <CustomRecipeTippsHeader position="1">Allgemeiner Tipp</CustomRecipeTippsHeader>
      <CustomRecipeTippsContent position="1">Für Fruchtpüree aus frischen Pfirsichen brauchen Sie gut 2 kg Früchte. Pfirsiche waschen, schälen, entkernen. Fruchtfleisch in kleine Stücke schneiden und mit Zitronensaft pürieren. Evtl. zusätzlich etwas Pfirsichsaft dazugeben.</CustomRecipeTippsContent>
    </CustomRecipeTipps>
