    <CustomRecipePreparationSteps taggroup_id="7d9f7c">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Ofen auf 180 Grad (Umluft 160 Grad) vorheizen. Rhabarber schälen, klein würfeln, 3–4 Min. in einem Topf in der Brühe mit 1 Prise Zucker garen. In ein Sieb abgießen. Sud auffangen, mit Zitronensaft, -schale, Pfeffer, Salz, Öl verquirlen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="7d9f8b">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="2">Zubereitungsschritt 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="2">Forellenfilets in Backpapier wickeln, 8–10 Min. auf dem Ofenrost erwärmen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="7d9f98">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="3">Zubereitungsschritt 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="3">Schupfnudeln 5–10 Min. in der Butter anbraten.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="7d9fa5">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="4">Zubereitungsschritt 4</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="4">Filets von der Haut lösen, in Stücke teilen, mit Schupfnudeln anrichten. Rhabarber, Vinaigrette, evtl. Lauchstreifen daraufgeben.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
