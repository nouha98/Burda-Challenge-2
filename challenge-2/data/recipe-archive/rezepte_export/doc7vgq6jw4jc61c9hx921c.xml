      <CustomRecipeIngredient topic="tmt_ingredient_food_multisite_9721" plural="Sahne" position="1" unit_topic="tmt71k9kn9q8q8hixpkdbg" amount="250" unit="g"/>
      <CustomRecipeIngredient topic="tmt_ingredient_food_multisite_10841" plural="Vanillezucker" position="2" unit_topic="tmt733d3znh64n1c9wecjrs" amount="2" unit="Packung"/>
      <CustomRecipeIngredient topic="tmt_ingredient_food_multisite_8946" plural="Puderzucker" position="3" unit_topic="tmt71k9kn9q8q8hixpkdbg" amount="50" unit="g"/>
      <CustomRecipeIngredient topic="tmt_ingredient_food_multisite_6656" plural="Himbeeren" position="4" unit_topic="tmt71k9kn9q8q8hixpkdbg" amount="150" unit="g"/>
