      <CustomRecipeTippsLabel position="1">Tipps 1</CustomRecipeTippsLabel>
      <CustomRecipeTippsHeader position="1">Tipp</CustomRecipeTippsHeader>
      <CustomRecipeTippsContent position="1"> Verrückt nach Kokos? Dann den Eierlikör durch die gleiche Menge Kokoslikör ersetzen</CustomRecipeTippsContent>
