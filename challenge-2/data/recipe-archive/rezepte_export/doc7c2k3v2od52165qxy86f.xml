      <CustomRecipeIngredient topic="tmt7c10xsvfarrnqe4b2q8" amount="1" unit_topic="tm_topic_default_unit" position="1" unit="(Keine Einheit)" plural="Portion Mürbeteig (Grundrezept; jedoch mit 150 g Zucker und 2 Eiern)"/>
      <CustomRecipeIngredient topic="tmt796rq6nt0ch17bxieffr" amount="3" unit_topic="tmt71k9l0iwtqu1gbohwdbs" position="2" unit="EL" plural="Backkakao"/>
      <CustomRecipeIngredient topic="tmt7c0zrppqzjd1kpusxbmf" unit_topic="tm_topic_default_unit" position="3" unit="(Keine Einheit)" plural="weiße Zuckerschrift"/>
