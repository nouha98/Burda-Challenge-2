    <CustomRecipePreparationSteps taggroup_id="db985e">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="1">Am Vortag: 300 g Doppelrahm-Frischkäse mit  200 g Schmand, Saft und abgeriebener Schale von  2 Limetten (Bio), 1 Pck. Vanillinzucker und 2 EL  braunem Zucker glatt rühren. Zugedeckt kalt stellen.  </CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="db98a6">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="2">Zubereitungsschritt 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="2">2 Stunden vorm Servieren: 2 Limetten (Bio) waschen, trocken tupfen, in Spalten schneiden. Blättchen  von ¼ Bund Minze mit 2 EL braunem Zucker im  Blitzhacker mixen. Creme in einen Spritzbeutel  mit großer Sterntülle füllen und in Eiswaffelbecher  (mit Schokolade) spritzen, kalt stellen.  </CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="db98c0">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="3">Zubereitungsschritt 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="3">Zum Servieren: Creme mit Minzzucker, Minz­blättchen und Limettenspalten garnieren.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
