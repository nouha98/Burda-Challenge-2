    <CustomRecipePreparationSteps taggroup_id="b4abbd">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="1">Schoko-Drops in einer Schüssel über einem heißen Wasserbad schmelzen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="b4ac02">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="2">Zubereitungsschritt 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="2">Geschmolzene Schokolade mit Milch, Sahne, Kakaopulver, Zucker, Milchpulver, Bindemitteln und Salz in einer Schüssel gründlich verrühren.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="b4ac11">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="3">Zubereitungsschritt 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="3">Ingwer schälen, fein reiben und zur Schokomasse geben.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="b4ac1e">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="4">Zubereitungsschritt 4</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="4">Schoko-Mix in eine Eismaschine füllen und cremig gefrieren lassen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="b4ac2d">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="5">Zubereitungsschritt 5</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="5">Eis portionieren und nach Belieben mit kandierten Ingwerstückchen anrichten.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipeTipps taggroup_id="b4ad92">
      <TagGroupConfig/>
      <CustomRecipeTippsLabel/>
      <CustomRecipeTippsHeader position="1">Ohne Eismaschine </CustomRecipeTippsHeader>
      <CustomRecipeTippsContent position="1">Alle Sorten funktionieren auch ohne Eismaschine. Masse in eine Metallschale füllen, mit Deckel verschließen und tiefkühlen. Die ersten 4–5 Std. alle 30 Minuten vom Rand nach innen durchrühren. Nach ca. 8 Stunden sollte das Eis fertig durchgefroren sein.</CustomRecipeTippsContent>
    </CustomRecipeTipps>
