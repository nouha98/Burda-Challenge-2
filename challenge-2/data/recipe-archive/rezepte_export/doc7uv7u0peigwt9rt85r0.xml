    <CustomRecipePreparationSteps taggroup_id="987bf7">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="1"> Ofen auf 200 Grad Ober-/Unterhitze vorheizen. Ein Blech mit Backpapier belegen. Spargel waschen, schälen, holzige Enden abbrechen. Spargel auf dem Blech mit 1⁄2 EL Öl, Salz und Pfeffer mischen. Ca. 25 Min. im Ofen rösten.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="987c2e">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="2">Zubereitungsschritt 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="2"> Für die Romesco-Soße Paprika abtropfen. Knoblauch abziehen, hacken. Tomaten abbrausen, halbieren, putzen. Mit 1 EL Petersilie, Paprika, Mandeln, Essig, Knoblauch, Paprikapulver und Cayenne pürieren. Dabei 2 EL Öl langsam angießen. Salzen, pfeffern.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="987c46">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="3">Zubereitungsschritt 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="3"> Spargel mit Soße und übriger Petersilie anrichten. Dazu passt Radicchio-Kräuter-Salat.</CustomRecipePreparationsStepsContent>
