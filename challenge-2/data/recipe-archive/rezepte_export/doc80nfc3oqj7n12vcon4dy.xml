      <TagGroupConfig/>
      <CustomRecipePreparationsStepsContent position="2">Konfitüre auf vier saubere Gläser (je ca. 350 g) einfüllen, verschließen und über Nacht festwerden lassen.</CustomRecipePreparationsStepsContent>
      <CustomRecipePreparationStepsLabel position="2">Schritt 2</CustomRecipePreparationStepsLabel>
    </CustomRecipePreparationSteps>
