    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_primary">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Nudeln nach Packungsangabe in reichlich Salzwasser in ca. 10 Minuten bissfest kochen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_2_68ffd38514178">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Inzwischen Schinkenspeck in Streifen schneiden. Zwiebel abziehen und würfeln. Beides in einer Pfanne im heißen Öl 2–3 Minuten anschwitzen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_3_68ffd4aeb4611">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Den Ofen auf 180 Grad Ober- und Unterhitze vorheizen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_4_68ffd4b9152cd">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 4</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Thymian abbrausen und trocken schütteln – ein wenig zum Garnieren beiseitelegen und vom Rest die Blätter abstreifen. Mit Eiern, Milch und dem Parmesan verquirlen und nach Gusto mit Salz und Pfeffer würzen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_5_68ffd4d44feb6">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 5</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Nudeln, Speck und Zwiebeln unter die Eier-Milch-Masse mischen und in eine Auflaufform (ca. 20 x 30 cm) füllen. Mit Mozzarella bestreuen und ca. 35 Minuten im Ofen goldbraun überbacken.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_6_68ffd4ed762bd">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 6</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Mit frischem Thymian garniert servieren.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
