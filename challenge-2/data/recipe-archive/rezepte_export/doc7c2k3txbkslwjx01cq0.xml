    <CustomRecipePreparationSteps taggroup_id="616a7b">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Mehl mit Mandeln mischen. Butter in Stücken zugeben, Zucker Sahne zufügen, verkneten. Teig in Folie 1 Std. kalt stellen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="616a8d">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="2">Zubereitungsschritt 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="2">Backofen auf 200 Grad (Umluft 180 Grad) vorheizen. Teig auf leicht bemehlter Arbeitsfläche ca. 5 mm dünn ausrollen. Blüten ausstechen. Bei der Hälfte der Formen jeweils in der Mitte ein rundes Loch ausstechen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="616a9a">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="3">Zubereitungsschritt 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="3">Kekse auf mit Backpapier belegte Bleche geben. 8–10 Min. goldgelb backen. Auf Kuchengitter abkühlen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="616aa6">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="4">Zubereitungsschritt 4</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="4">Kekse mit Loch mit Puderzucker bestäuben. Gelee mit Arrak verrühren. Ganze Plätzchen mit Gelee bestreichen, Plätzchenringe auflegen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
