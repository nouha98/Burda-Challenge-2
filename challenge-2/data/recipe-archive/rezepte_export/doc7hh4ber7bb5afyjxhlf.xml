    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_primary">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Brühe  mit  Bulgur  aufkochen.  8–10  Min.  zugedeckt köcheln.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_2_613afdbccf241">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Zucchini,   Samen,   Mehl,   Zwiebel,   Knoblauch   unter den Bulgur mengen. 20 Min. quellen lassen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_3_613afdd5e8775">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Die  gerösteten  Paprika  im  Mixer  pürieren.  Mit  Senf,  Salz  und  Pfeffer  unter  den  Bulgur  mengen.  Aus der Masse 6 Bratlinge formen. Diese 5 Min. je Seite  in  einer  Pfanne  in  Öl  braten.  Die  Brötchen  halbieren. Schnittlauch und Salatcreme verrühren. Mit  Rucola,  Bratling,  Gurke  und  evtl.  Basilikum  zwischen die Brötchenhälften schichten.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
