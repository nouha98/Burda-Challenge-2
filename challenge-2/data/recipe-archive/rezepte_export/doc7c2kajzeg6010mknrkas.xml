      <CustomRecipeIngredient topic="tmt7866530cw079p0kyidm" amount="100" unit_topic="tmt71k9kn9q8q8hixpkdbg" position="5" unit="g" plural="Gelierzucker (3:1)"/>
      <TagGroupConfig/>
