    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="82efpl87kwphb5g2u9w">
      <TagGroupConfig/>
      <CustomRecipePreparationsStepsContent position="2">Ananas schälen, den Strunk entfernen und in Würfel schneiden. Orange und Limette halbieren und den Saft auspressen.</CustomRecipePreparationsStepsContent>
      <CustomRecipePreparationStepsLabel position="2">Schritt 2</CustomRecipePreparationStepsLabel>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="82efpl87l1lxqnr6u9w">
      <TagGroupConfig/>
      <CustomRecipePreparationsStepsContent position="3">Mango, Ananas, Orangensaft, 2 TL Limettensaft und Kokosmilch in den Mixer geben und zu einem feinen Smoothie pürieren. Auf 2 Gläser aufteilen und genießen!</CustomRecipePreparationsStepsContent>
