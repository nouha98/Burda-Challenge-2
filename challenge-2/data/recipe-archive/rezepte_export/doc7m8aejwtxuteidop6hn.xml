    <CustomRecipePreparationSteps taggroup_id="f70d84">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="1">Suppengemüse waschen, putzen, klein würfeln. Zwiebel abziehen, würfeln.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="f70dca">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="2">Zubereitungsschritt 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="2">Suppengemüse und Zwiebel im heißen Öl in einem großen Topf andünsten. Tomatenmark und Hack dazugeben, krümelig braten. Salzen, pfeffern. Tomaten und Brühe dazugeben, aufkochen. Mit Paprika und Kräutern würzen. 30 Min. bei Hitze köcheln lassen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="f70dda">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="3">Zubereitungsschritt 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader/>
      <CustomRecipePreparationsStepsContent position="3">Zutaten auf zwei Gläser oder Boxen verteilen, auskühlen lassen und bis zur Verwendung zugedeckt kalt stellen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipeTipps taggroup_id="f70e54">
      <TagGroupConfig/>
      <CustomRecipeTippsLabel/>
      <CustomRecipeTippsHeader/>
      <CustomRecipeTippsContent position="1">Haltbarkeit: gekühlt 3–4 Tage oder tiefgekühlt 3 Monate.</CustomRecipeTippsContent>
    </CustomRecipeTipps>
    <CustomRecipeTipps taggroup_id="f70e7f">
