      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritt 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="1">Lauchzwiebeln putzen, waschen und schräg in dünne Ringe schneiden. Ingwer schälen, fein hacken. Shrimps abgießen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="9ba8ef">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="2">Zubereitungsschritt 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsContent position="2">Öl in einem Topf erhitzen, Lauchzwiebeln, Ingwer und Shrimps andünsten, mit Curry bestäuben. Kokosmilch angießen, 5 Minuten einköcheln. Mit Salz und Pfeffer würzen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="9ba905">
