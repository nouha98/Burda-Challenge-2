    <CustomRecipeIngredients taggroup_id="customrecipeingredients_primary">
      <CustomRecipeIngredient topic="tmt_ingredient_food_multisite_6211" position="1" amount="6" unit_topic="tmt71k9l2t09xx1jfg9ydbs" unit="Blatt" plural="Gelatine"/>
