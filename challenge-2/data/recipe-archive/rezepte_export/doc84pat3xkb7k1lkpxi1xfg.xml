    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_primary">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 1</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader position="1">Basis mixen</CustomRecipePreparationsStepsHeader>
      <CustomRecipePreparationsStepsContent position="1">Joghurt, Wasser oder Mandelmilch, gemahlene Mandeln, Kurkuma, Ingwer, Honig, Zimt und Salz in einen Mixer oder ein hohes Gefäß geben.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_2_699c7a202eb20">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 2</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader position="1">Fein pürieren</CustomRecipePreparationsStepsHeader>
      <CustomRecipePreparationsStepsContent position="1">Alles gut durchmixen, bis der Lassi schön cremig und leicht schaumig ist. Bei Bedarf mit etwas mehr Wasser/Mandelmilch auf die gewünschte Trinkkonsistenz verdünnen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_3_699c7a2fe4e6c">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 3</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader position="1">Abschmecken</CustomRecipePreparationsStepsHeader>
      <CustomRecipePreparationsStepsContent position="1">Probieren und nach Geschmack mehr Honig und optional Zitronen- oder Limettensaft zugeben.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
    <CustomRecipePreparationSteps taggroup_id="customrecipepreparationsteps_4_699c7a39c5cf8">
      <TagGroupConfig/>
      <CustomRecipePreparationStepsLabel position="1">Zubereitungsschritte 4</CustomRecipePreparationStepsLabel>
      <CustomRecipePreparationsStepsHeader position="1">Servieren</CustomRecipePreparationsStepsHeader>
      <CustomRecipePreparationsStepsContent position="1">In 4 Gläser füllen und mit gehackten Mandeln bestreuen. Am besten gut gekühlt genießen.</CustomRecipePreparationsStepsContent>
    </CustomRecipePreparationSteps>
